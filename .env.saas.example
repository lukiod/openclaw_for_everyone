# =============================================================================
# OpenClaw SaaS — environment configuration
# Copy this to .env.saas and fill in the values
# =============================================================================

# ---- Control Plane ----------------------------------------------------------
# A long random secret for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CONTROL_PLANE_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Port nginx listens on (default: 80 / 443)
HTTP_PORT=80
HTTPS_PORT=443

# Path to TLS certs on the host (must contain fullchain.pem + privkey.pem)
# For Let's Encrypt / Certbot: /etc/letsencrypt/live/yourdomain.com
TLS_CERT_DIR=./certs

# ---- Default AI API Keys (inherited by all tenants unless overridden) -------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
